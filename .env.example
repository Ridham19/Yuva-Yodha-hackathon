# ==============================================================================
# ⚡ GRIDPULSE™ SMART GRID SCADA & AI AUTOMATION PLATFORM
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your local settings and API credentials.
# cp .env.example .env
# ==============================================================================

# --- [1. Core SCADA Backend & Telemetry Server] ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# --- [2. Production-Grade Relational Database (Native SQLite)] ---
# Path to local persistent SQLite relational store & time-series audit log
GRIDPULSE_DB_PATH=backend/data/gridpulse.db
DB_PRAGMA_JOURNAL_MODE=WAL
DB_PRAGMA_SYNCHRONOUS=NORMAL

# --- [3. Python AI/ML Microservice (FastAPI + PyTorch + Scikit-Learn)] ---
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=127.0.0.1

# --- [4. Cryptographic Authentication & Zero-Trust Cyber Keys] ---
# Session signing key for control room SCADA operator dispatches
JWT_SECRET=your_jwt_secret_key_here
# Machine-to-Machine API key for programmatic breaker dispatches
SCADA_DISPATCH_API_KEY=your_scada_api_key_here
# IEC 62351 Substation Zero-Trust Mutual TLS / Token for Feeder IEDs
IEC62351_ZERO_TRUST_TOKEN=your_iec62351_token_here

# --- [5. National Grid & Energy Market Integration Keys] ---
# Indian Energy Exchange (IEX) Real-Time Market (RTM) clearing API token
IEX_MARKET_API_KEY=your_iex_api_key_here
# POSOCO / NLDC (National Load Despatch Centre) Frequency stream key
POSOCO_NLDC_FEED_KEY=your_posoco_feed_key_here
# Central Electricity Authority (CEA) Schedule-V Automated Compliance Registry upload key
CEA_REGULATORY_TOKEN=your_cea_registry_token_here

# --- [6. Weather & Solar Nowcasting APIs (Duck Curve Sensitivity)] ---
# Solar irradiance and ambient temperature telemetry provider
WEATHER_API_KEY=your_weather_api_key_here
# India Meteorological Department (IMD) INSAT-3D cloud cover nowcasting feed key
IMD_SATELLITE_FEED_KEY=your_imd_satellite_key_here

# --- [7. Client Frontend Configuration (Vite import.meta.env)] ---
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
VITE_ML_SERVICE_URL=http://127.0.0.1:8000
VITE_APP_NAME="GridPulse Smart Grid SCADA"
VITE_OPERATOR_DISCOM="BRPL / Delhi Transco Ltd"
VITE_GRID_ZONE="Northern Regional Load Despatch Centre (NRLDC)"
